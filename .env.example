# ─────────────────────────────────────────────
# Vauxtra — Environment Configuration
# Copy to .env and customize as needed.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ─── Security ────────────────────────────────

# Secret key for encrypting provider credentials and signing sessions.
# Auto-generated on first run if left empty (stored in data/.secret_key).
# DO NOT CHANGE after adding providers — credentials will become unreadable.
SECRET_KEY=

# Password to protect the web interface, as a PBKDF2 hash.
# Leave empty → configure via Setup wizard on first launch.
# Set here → takes priority over the wizard-configured password.
# Generate the value:
#   python -c "from app.auth import hash_password; print(hash_password('your-password'))"
# A value that is not a hash is REFUSED (401, and the wizard stays closed) unless
# ALLOW_PLAINTEXT_APP_PASSWORD below is enabled.
APP_PASSWORD=

# Accept a plaintext APP_PASSWORD instead of a hash. Off by default: the password would
# then sit in clear text in this file, in your shell history and in `docker inspect`.
ALLOW_PLAINTEXT_APP_PASSWORD=false

# ─── General ─────────────────────────────────

# Timezone for scheduling and log timestamps
TZ=UTC

# Set to true whenever this interface is reached over https://, INCLUDING behind a
# reverse proxy that terminates TLS -- which is the usual deployment. It marks the session
# cookie `Secure` and sends HSTS. This line used to read "not behind a reverse proxy",
# which told operators to leave it off in precisely the case that needs it.
# Leave it false only while reaching the instance over plain http (localhost, a LAN test):
# a `Secure` cookie is not sent over http at all, so logging in would appear to do nothing.
HTTPS_ONLY=false

# Address of the reverse proxy in front of this instance (comma-separated, or `*` for any).
# Unset, the application reads the socket peer as the client address -- behind a proxy that
# is the proxy, for everyone, so the login limit of 5/minute is shared by every visitor and
# one attacker locks you out. Set, uvicorn honours `X-Forwarded-For` and each visitor is
# counted on their own address. Do not set it without a proxy actually in front: it lets
# the caller choose the address every rate limit and log line is attributed to.
# FORWARDED_ALLOW_IPS=172.18.0.2

# Enable debug mode: exposes /api/docs (Swagger UI) and verbose logging
DEBUG=false

# ─── MCP Server ──────────────────────────────
# URL of this Vauxtra instance (used by the MCP server to call the API)
VAUXTRA_URL=http://localhost:8888

# API key for MCP server authentication (create one in Settings → API Keys)
VAUXTRA_API_KEY=

# Interface and port `vauxtra-mcp --http` binds to. The default stays on the loopback
# because the bridge speaks for an API key with whatever scopes that key carries, and the
# HTTP transport itself asks for no credential: anything that can reach the port is the
# bridge. Move it off 127.0.0.1 only behind a proxy that authenticates.
# VAUXTRA_MCP_HOST=127.0.0.1
# VAUXTRA_MCP_PORT=9000

# Seconds the bridge waits on a Vauxtra API call. The default is generous because one push
# or reconcile walks every configured provider in series, each with its own timeout: at
# 30 s the tool reported a failure for work the server went on to finish.
# VAUXTRA_TIMEOUT=120

# ─── Network ─────────────────────────────────
# Comma-separated list of cross-origin callers allowed to reach the API. Empty is the
# default and the right answer for a normal install: the interface is served by this same
# application, so it is already same-origin. Fill it in only for a frontend hosted
# elsewhere -- every origin listed here may send the session cookie. `DEBUG=true` adds the
# Vite dev server origins by itself; there is no need to list them.
# CORS_ORIGINS=https://vauxtra.example.com

# ─── Docker ──────────────────────────────────
# Socket used to create the FIRST Docker endpoint, on a database that has none. It seeds a
# row and nothing more: from then on the endpoint list in Settings → Data owns the value,
# and changing this variable does nothing at all. Point a running instance at another
# socket -- a read-only proxy, say -- from that screen, not from here.
# DOCKER_HOST=unix:///var/run/docker.sock

# ─── Providers ───────────────────────────────
# Rewrite `localhost`, `127.0.0.1` and `::1` in a provider URL to a host-reachable name
# when Vauxtra runs in a container. On by default, and it is usually what you want: inside
# the container `localhost` is the container, so a provider added as
# `http://localhost:81` would otherwise be unreachable with no explanation. Turn it off
# when the provider genuinely runs in this same container or network namespace.
# VAUXTRA_REWRITE_LOCALHOST=true

# The name the rewrite above points at. `host.docker.internal` resolves on Docker Desktop
# and on Linux with `extra_hosts: ["host.docker.internal:host-gateway"]`; without either,
# set this to the host's address on the container network.
# VAUXTRA_LOCALHOST_ALIAS=host.docker.internal

# Extra provider types, as importable Python module names (comma- or semicolon-separated).
# Each module exposes `register()`, `PROVIDER_PLUGIN` or `PROVIDER_PLUGINS`. These modules
# are IMPORTED, so their code runs with the application's privileges -- load only modules
# you wrote or audited. A module that fails to load is logged as a warning and skipped;
# the application still starts, with that provider type simply absent.
# VAUXTRA_PROVIDER_PLUGINS=my_company.vauxtra_caddy
